\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesExplPackage{tuatreporttitle}{2026-11-18}{2.0.0}
  {TUAT lab report cover sheets}

\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{arydshln}

% Named metadata, rather than one generated command per field.
\prop_new:N \g__tuat_metadata_prop
\seq_new:N \g__tuat_dates_seq
\seq_new:N \g__tuat_collaborators_seq
\seq_new:N \g__tuat_submission_dates_seq
\seq_new:N \g__tuat_due_dates_seq
\keys_define:nn { tuat }
  {
    title      .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { title } {#1},
    course     .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { course } {#1},
    theme      .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { theme } {#1},
    instructor .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { instructor } {#1},
    name       .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { name } {#1},
    student-id .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { student-id } {#1},
    year       .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { year } {#1},
    semester   .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { semester } {#1},
    credits    .code:n = \prop_gput:Nnn \g__tuat_metadata_prop { credits } {#1},
    experiment-dates .code:n = \seq_gset_from_clist:Nn \g__tuat_dates_seq {#1},
    collaborators    .code:n = \seq_gset_from_clist:Nn \g__tuat_collaborators_seq {#1},
    submission-dates .code:n = \seq_gset_from_clist:Nn \g__tuat_submission_dates_seq {#1},
    due-dates        .code:n = \seq_gset_from_clist:Nn \g__tuat_due_dates_seq {#1},
  }
\keys_set:nn { tuat }
  { title = 実験報告書, year = 1, semester = 前期, credits = 2 }

\cs_new:Npn \__tuat_value:n #1
  { \prop_item:Nn \g__tuat_metadata_prop {#1} }

\NewDocumentCommand \tuatsetup { m }
  { \keys_set:nn { tuat } {#1} }

% Assemble rows before entering the alignment. Keep at least five writing rows;
% extra records add rows rather than disappearing or requiring new macros.
\tl_new:N \l__tuat_experiment_rows_tl
\tl_new:N \l__tuat_submission_rows_tl
\cs_new:Npn \__tuat_item:Nn #1#2
  {
    \int_compare:nNnF {#2} > { \seq_count:N #1 }
      { \seq_item:Nn #1 {#2} }
  }
\cs_new:Npn \__tuat_experiment_cells:n #1
  {
    #1 & \__tuat_item:Nn \g__tuat_dates_seq {#1} &
    \__tuat_item:Nn \g__tuat_collaborators_seq {#1}
  }
\cs_new:Npn \__tuat_submission_cells:n #1
  {
    \int_compare:nNnTF {#1} = {1}
      {初}
      {
        \int_compare:nNnF {#1} > { \seq_count:N \g__tuat_submission_dates_seq }
          {再}
      } &
    \__tuat_item:Nn \g__tuat_submission_dates_seq {#1} &
    \__tuat_item:Nn \g__tuat_due_dates_seq {#1}
  }

\cs_new_protected:Npn \__tuat_build_rows:nNNn #1#2#3#4
  {
    \tl_clear:N #2
    \int_step_inline:nn { \int_max:nn {5} {#1} }
      {
        \tl_put_right:Nn #2
          { #3 {##1} & \multicolumn{3}{c|}{} \\ #4 }
      }
  }

% Deliberately do not replace standard \title, \author, \date or \maketitle.
\NewDocumentCommand \maketuatcover { }
  {
    \clearpage
    \newgeometry{left=15mm,right=15mm,top=20mm,bottom=10mm}
    \group_begin:
      \thispagestyle{empty}
      \setlength{\dashlinegap}{1pt}
      \setlength{\arrayrulewidth}{1pt}
      \renewcommand{\arraystretch}{1.4}
      \__tuat_build_rows:nNNn
        { \int_max:nn { \seq_count:N \g__tuat_dates_seq }
            { \seq_count:N \g__tuat_collaborators_seq } }
        \l__tuat_experiment_rows_tl \__tuat_experiment_cells:n
        { \cdashline{1-2} \cline{3-3} }
      \__tuat_build_rows:nNNn
        { \int_max:nn { \seq_count:N \g__tuat_submission_dates_seq }
            { \seq_count:N \g__tuat_due_dates_seq } }
        \l__tuat_submission_rows_tl \__tuat_submission_cells:n
        { \cdashline{1-3} }
      \begin{center}
        {\LARGE\bfseries \__tuat_value:n { title }\par}
        \bigskip
        \resizebox*{\textwidth}{0.85\textheight}
          {
            \begin{tabular}{|c|c|c|c|c|c|}
              \hline
              \multicolumn{3}{|c|}{\textbf{実験演習記録}} &
              \multicolumn{3}{c|}{\textbf{判定・指示}} \\
              \hline
              & 年月日時 & 共同作業者 & \multicolumn{3}{c|}{} \\
              \cline{1-3}
              \tl_use:N \l__tuat_experiment_rows_tl
              \multicolumn{3}{|c|}{\textbf{レポート提出記録}} &
              \multicolumn{3}{c|}{} \\
              \cline{1-3}
              & 提出年月日 & 期限年月日 & \multicolumn{3}{c|}{} \\
              \cline{1-3}
              \tl_use:N \l__tuat_submission_rows_tl
              \hline
              \multicolumn{2}{|c|}{\textbf{科目名}} &
              \textbf{テーマ指導教員} & \textbf{学年} &
              \textbf{学期} & \textbf{単位} \\
              \hline
              \multicolumn{2}{|c|}{\__tuat_value:n { course }} &
              \__tuat_value:n { instructor } & \__tuat_value:n { year } &
              \__tuat_value:n { semester } & \__tuat_value:n { credits } \\
              \hline
              \multicolumn{2}{|c|}{\textbf{テーマ番号・テーマ名}} &
              \textbf{学籍番号} & \multicolumn{3}{c|}{\textbf{名前}} \\
              \hline
              \multicolumn{2}{|c|}{\__tuat_value:n { theme }} &
              \__tuat_value:n { student-id } &
              \multicolumn{3}{c|}{\__tuat_value:n { name }} \\
              \hline
            \end{tabular}
          }
        \par\bigskip
        {\large 東京農工大学　工学部　知能情報システム工学科\par}
      \end{center}
      \clearpage
    \group_end:
    \restoregeometry
    \setcounter{page}{1}
  }

\endinput
